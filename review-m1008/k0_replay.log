## lean k0_axioms.lean
'TheoremK0.theoremK0_ringChar' depends on axioms: [propext, Classical.choice, Quot.sound]
'TheoremK0Strong.theoremK0_strong_ringChar' depends on axioms: [propext, Classical.choice, Quot.sound]
@TheoremK0.theoremK0_ringChar : ∀ {K : Type u_1} [inst : Field K] {A B : Polynomial K} {q0 : K} {h D : ℕ},
  1 ≤ D →
    4 * D < h →
      ringChar K = 0 ∨ 4 * h < ringChar K →
        A.Monic →
          A.natDegree = h →
            B.natDegree ≤ h →
              Polynomial.eval 0 B ≠ 0 →
                q0 ≠ 0 →
                  A ^ 3 + Polynomial.X ^ (2 * h - D) * B ^ 3 =
                      Polynomial.C q0 * (Polynomial.X ^ (2 * h - D + 2 * h) * A + B) →
                    False
