@CGCore.cg_field : ∀ {L : Type u_1} [inst : Field L] (F T H : Polynomial L) (h c e : ℕ),
  1 ≤ c →
    c < h →
      e = 2 * h + c →
        F.Monic →
          F.natDegree = h →
            F.coeff 0 ≠ 0 →
              F ∣ Polynomial.X ^ e - 1 →
                T.natDegree ≤ h - c →
                  F ^ 3 = T + Polynomial.X ^ (2 * h - c) * H → (∀ (n : ℕ), 0 < n → n ≤ 4 * h + c - 2 → ↑n ≠ 0) → False
exit 0
